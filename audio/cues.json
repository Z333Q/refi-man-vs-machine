{
  "$comment": "Source of truth for the audio pipeline. Each cue maps a WAV master in audio/masters/ to one or more production encodes in public/audio/. Cue numbers follow the game.refi.trading production prompt set (1-13 music, 14-50 SFX and ambience). Run: node scripts/audio-build.mjs",
  "encode": {
    "music": {
      "codec": "libopus",
      "bitrate": "160k",
      "ext": "opus"
    },
    "ambience": {
      "codec": "libopus",
      "bitrate": "112k",
      "ext": "opus"
    },
    "sfx": {
      "codec": "libvorbis",
      "quality": "5",
      "ext": "ogg"
    }
  },
  "cues": [
    {
      "cue": 1,
      "id": "0930-full",
      "title": "Title Theme, 9:30 (full)",
      "kind": "music",
      "master": "0930-theme.wav",
      "source": "ReFi Opening Bell-Theme",
      "loop": false,
      "note": "Full 3:00 render for the credits or finale. Not for the title screen."
    },
    {
      "cue": 1,
      "id": "0930-intro",
      "title": "Title Theme, 9:30 (intro)",
      "kind": "music",
      "master": "0930-theme.wav",
      "source": "ReFi Opening Bell-Theme",
      "trim": {
        "start": 0,
        "end": 30
      },
      "loop": false,
      "note": "Plays once on the title screen, then hands off to 0930-loop. Loop point at 0:30 is the spec default; confirm by ear against the master."
    },
    {
      "cue": 1,
      "id": "0930-loop",
      "title": "Title Theme, 9:30 (loop)",
      "kind": "music",
      "master": "0930-theme.wav",
      "source": "ReFi Opening Bell-Theme",
      "trim": {
        "start": 30,
        "end": 90
      },
      "loop": true,
      "note": "0:30 to 1:30 of the master, repeated under the title UI. Master is 3:00; the remaining 1:30 is unused until the loop point is confirmed."
